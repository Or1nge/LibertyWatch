# Copy to ~/.config/liberty-watch/collector.env and adjust only if needed.
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
# 20 is compatible with the documented Hong Kong BMP snapshot limit.
FUTU_BATCH_SIZE=20
LIBERTY_WATCHLIST_FILE=/home/or1ngelinux/Liberty/webapp/config/watchlist.json
LIBERTY_SNAPSHOT_OUTPUT=/home/or1ngelinux/Liberty/webapp/runtime/latest_snapshot.json
LIBERTY_FX_CACHE=/home/or1ngelinux/Liberty/webapp/runtime/ecb_hkd_cny.json
LIBERTY_HISTORY_OUTPUT=/home/or1ngelinux/Liberty/webapp/runtime/weekly_history.json
LIBERTY_HISTORY_YEARS=10
LIBERTY_HISTORY_REQUEST_PAUSE=0.55
LIBERTY_SSH_HOST=ali
LIBERTY_REMOTE_PATH=/usr/LibertyWatch/shared/latest_snapshot.json
LIBERTY_HISTORY_REMOTE_PATH=/usr/LibertyWatch/shared/weekly_history.json
LIBERTY_CONNECT_TIMEOUT=15
