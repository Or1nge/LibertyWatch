[Unit]
Description=Liberty 67-company dividend and buyback monitor
After=network-online.target futu-opend.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/or1ngelinux/Liberty
ExecStart=/home/or1ngelinux/Liberty/tools/futu-opend/.venv/bin/python /home/or1ngelinux/Liberty/scripts/dividend_buyback_monitor.py run
TimeoutStartSec=30min
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/or1ngelinux/Liberty/data/monitor
ReadWritePaths=/home/or1ngelinux/Liberty/outputs/companies
ReadWritePaths=/home/or1ngelinux/.codex
ReadWritePaths=/home/or1ngelinux/.com.futunn.FutuOpenD/Log

[Install]
WantedBy=default.target
