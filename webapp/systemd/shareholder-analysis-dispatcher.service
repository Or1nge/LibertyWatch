[Unit]
Description=Liberty deterministic Codex analysis dispatcher
After=shareholder-data-pipeline.service

[Service]
Type=oneshot
User=liberty
Group=liberty
WorkingDirectory=/opt/liberty/shareholder-v2/current
EnvironmentFile=/etc/liberty/shareholder-v2.env
ExecStart=/opt/liberty/shareholder-v2/current/.venv/bin/python scripts/shareholder_v2.py dispatch
TimeoutStartSec=120
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/liberty
RestrictSUIDSGID=true
LockPersonality=true
StandardOutput=journal
StandardError=journal
