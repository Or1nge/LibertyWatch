# Feature flag and Ali read-only paths (Compose / FastAPI)
SHAREHOLDER_RETURN_V2_ENABLED=false
LIBERTY_SHARED_DIR=/usr/LibertyWatch/shared
LIBERTY_PUBLIC_PORT=5048

# Existing Web code deployment. Host may be an SSH config/tunnel alias.
LIBERTY_REMOTE_HOST=replace-with-ssh-alias
LIBERTY_REMOTE_BASE=/usr/LibertyWatch
LIBERTY_PUBLIC_HOST=replace-with-public-host

# Linux data/analysis service. The installer defaults to the existing project owner;
# LIBERTY_SERVICE_USER/LIBERTY_CODEX_HOME are installer-time options, not secrets.
SHAREHOLDER_V2_LOCAL_ROOT=/var/lib/liberty/shareholder-v2
SHAREHOLDER_V2_STAGING_DIR=/var/lib/liberty/shareholder-v2/staging
SHAREHOLDER_V2_QUOTE_SNAPSHOT=/var/lib/liberty/shareholder-v2/inputs/latest_snapshot.json
ANALYSIS_JOB_DB=/var/lib/liberty/shareholder-v2/analysis/jobs.sqlite3
CODEX_BINARY=/usr/local/bin/codex
CODEX_TIMEOUT_SECONDS=1800
CODEX_GLOBAL_CONCURRENCY=1
CODEX_MAX_AUTOMATIC_RETRIES=2
CODEX_SCHEMA_RETRIES=1

# The installer pins HOME/CODEX_HOME for the selected existing service user.
# A separate liberty-codex account is optional hardening, not an online prerequisite.
# Never put an API key in a checked-in file.

# Ali push channel. The private key must be mode 0600 and readable by the service user.
ALI_SSH_HOST=replace-me
ALI_SSH_PORT=22
# Leave USER/KEY_PATH empty when ALI_SSH_HOST is an existing SSH config/tunnel
# alias that already defines User and IdentityFile.
ALI_SSH_USER=
ALI_SSH_KEY_PATH=
ALI_RELEASE_ROOT=/usr/LibertyWatch/shared/shareholder-v2
ALI_KEEP_RELEASES=5
ALI_CONNECT_TIMEOUT=15
